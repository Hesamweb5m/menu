# Copy to .env.local for local development (Vite reads .env.local and ignores
# it in git). Only variables prefixed with VITE_ reach the browser.

# Origin of the backend API. Defaults to http://localhost:1337 when unset,
# which is where `npm run dev` inside ./server listens.
# In production this is injected by the GitHub Pages workflow from the
# VITE_API_URL repository variable.
VITE_API_URL=http://localhost:1337

# Base path the site is served from. "/" for local dev and custom domains;
# "/menu/" for a GitHub Pages project site. The deploy workflow sets this.
VITE_BASE=/
