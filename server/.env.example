# Copy to server/.env for local development. Never commit the real .env.
# Hosting providers inject these as environment variables instead.

# ---- Required in production -------------------------------------------------

# Signing key for admin session tokens. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start in production without it. Changing it logs
# every admin out.
JWT_SECRET=

# Admin login for the /manage panel. ADMIN_PASSWORD is the source of truth:
# change it and restart to rotate the password. Leave it empty on first run and
# the server generates one and prints it to the log once.
ADMIN_EMAIL=admin@atlass.cafe
ADMIN_PASSWORD=

# Browser origins allowed to call the API, comma separated. Leave empty to
# allow any origin (fine while developing; set it once the frontend is live).
#   e.g. https://hesamweb5m.github.io,http://localhost:5173
CORS_ORIGINS=

# ---- Optional ---------------------------------------------------------------

# 1337 matches Strapi's default, which is what the frontend falls back to.
PORT=1337
HOST=0.0.0.0
NODE_ENV=development

# Where the SQLite database lives. This single file holds the entire menu
# including uploaded images, so it is the only thing that needs backing up or
# mounting on a persistent volume.
DATA_DIR=./data
# DATABASE_FILE=./data/menu.db

# How long an admin session lasts.
JWT_EXPIRES_IN=30d

# Upload ceiling per image, in bytes (default 10MB).
MAX_UPLOAD_BYTES=10485760
